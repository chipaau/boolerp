// Bool ERP API database: entity-relationship diagram in DBML.
// Paste into https://dbdiagram.io (or import this file) to view it.
//
// Only tables whose fields the user has explicitly confirmed are here, each added
// in the same change as its migration; the migrations are the source of truth.
// Modifications follow the same rule. Proposed designs (docs/platform/tenancy.md)
// are not drawn until their fields are confirmed. Partial indexes, CHECK
// constraints, triggers, and row-level security go in notes, since DBML cannot
// express them. See docs/data-model/README.md.

Project bool_erp {
  database_type: 'PostgreSQL'
  Note: 'Bool ERP API database (PostgreSQL 18).'
}

// ---------------------------------------------------------------------------
// identity module
// ---------------------------------------------------------------------------

Table users {
  id uuid [pk, default: `uuidv7()`]
  kratos_identity_id uuid [not null, unique, note: 'the Kratos identity (a token sub)']
  email text [not null, note: 'personal data: never logged, cached, or traced']
  phone text [not null, note: 'contact number, not an identifier (C85)']
  display_name text
  avatar_url text [note: 'the picture trait; http(s) and not blank (check); personal data']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Confirmed 2026-10-01 (C94), avatar_url added 2026-10-05; migration
  identity/migrations/00001_users.sql.
  One row per person who has used the platform; a projection of their Kratos
  account, written by POST /api/auth/me (C157). Global, not tenant-scoped. RLS (C126):
  read, create, and update policies, none for delete, so the API cannot delete users.
  '''
}

// ---------------------------------------------------------------------------
// reference (platform shared reference data, C122)
// ---------------------------------------------------------------------------

Table countries {
  code char(2) [pk, note: 'ISO 3166-1 alpha-2, e.g. MV; CHECK ^[A-Z]{2}$']
  alpha3 char(3) [not null, unique, note: 'ISO 3166-1 alpha-3, e.g. MDV; CHECK ^[A-Z]{3}$']
  name text [not null, note: 'English; not blank']
  phone_prefix text [not null, note: 'e.g. +960; CHECK ^\\+[0-9]{1,4}$']
  active_from timestamptz [not null, default: `now()`, note: 'when the code entered the ISO list']
  active_to timestamptz [note: 'when ISO withdrew it; null = current; CHECK active_to >= active_from']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  Note: '''
  Confirmed 2026-10-03 (C120, C121), meaning changed 2026-10-04 (C135); migration
  platform/reference/migrations/00001_countries.sql. The ISO 3166-1 list (249), loaded
  by cmd/deploy (production) and cmd/seed (development) from reference/seeds/countries.csv; a country is offered when it has
  legal forms. Global reference data. RLS enabled: everyone reads; no write policy yet
  (operator-only writes come with the operator rule), so only the migration role writes.
  '''
}

Table legal_forms {
  id uuid [pk, default: `uuidv7()`]
  country char(2) [not null, ref: > countries.code, note: 'ON DELETE RESTRICT']
  code text [not null, note: 'e.g. private_company; CHECK ^[a-z][a-z0-9_]{1,49}$']
  name text [not null, note: 'not blank']
  category text [not null, note: 'government | private | non_profit | international (CHECK)']
  identity_document text [note: 'the registration number its organisations carry; null = none; not blank']
  active_from timestamptz [not null, default: `now()`]
  active_to timestamptz [note: 'retired; null = offered; CHECK active_to >= active_from']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  indexes {
    (country, code) [unique]
    (id, country) [unique, note: 'target of tenants (legal_form_id, country); confirmed 2026-10-04']
  }

  Note: '''
  Confirmed 2026-10-04 (C136); migration platform/reference/migrations/00002_legal_forms.sql.
  What an organisation is in law, per country; the category is what cross-country rules
  attach to. Loaded by cmd/deploy and cmd/seed from reference/seeds/legal_forms.csv (the Maldives' 12).
  RLS enabled: everyone reads; no write policy yet, so only the migration role writes.
  '''
}

Table sectors {
  code text [pk, note: 'e.g. health; CHECK ^[a-z][a-z0-9_]{1,49}$']
  name text [not null, note: 'not blank']
  active_from timestamptz [not null, default: `now()`]
  active_to timestamptz [note: 'retired; null = in use; CHECK active_to >= active_from']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  Note: '''
  Confirmed 2026-10-04 (C136); migration platform/reference/migrations/00003_sectors.sql.
  The broad field an organisation works in, following ISIC's sections; global. Loaded by
  cmd/deploy and cmd/seed from reference/seeds/sectors.csv (15). RLS enabled: everyone
  reads; no write policy yet, so only the migration role writes.
  '''
}

Table institution_types {
  code text [pk, note: 'e.g. hospital; CHECK ^[a-z][a-z0-9_]{1,49}$']
  sector text [not null, ref: > sectors.code, note: 'ON DELETE RESTRICT; indexed']
  name text [not null, note: 'not blank']
  active_from timestamptz [not null, default: `now()`]
  active_to timestamptz [note: 'retired; null = in use; CHECK active_to >= active_from']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  Note: '''
  Confirmed 2026-10-04 (C136, C138); migration platform/reference/migrations/00004_institution_types.sql.
  The specific kind of organisation, each in one sector; global. A tenant has a primary
  type and any number of additional ones. Loaded by cmd/deploy and cmd/seed from
  reference/seeds/institution_types.csv (48). RLS enabled: everyone reads; no write
  policy yet, so only the migration role writes.
  '''
}

// ---------------------------------------------------------------------------
// tenancy module (C115, C136, C138)
// ---------------------------------------------------------------------------

Table tenants {
  id uuid [pk, default: `uuidv7()`]
  slug text [not null, unique, note: 'DNS label, 3-63; not reserved; locked once active (trigger)']
  code text [not null, unique, note: 'CHECK ^[A-Z0-9]{2,10}$; Bool\'s own short identifier']
  name text [not null, note: 'not blank']
  parent_id uuid [ref: > tenants.id, note: 'ON DELETE RESTRICT; not itself, no cycle, never the operator (trigger); indexed']
  is_operator boolean [not null, default: false, note: 'at most one true; never set by the runtime role (policies)']
  country char(2) [not null, ref: > countries.code, note: 'ON DELETE RESTRICT']
  legal_form_id uuid [note: 'FK (legal_form_id, country) -> legal_forms (id, country), ON DELETE RESTRICT']
  identity_number text [note: 'the number of the document the legal form names; unique per country (case-insensitive)']
  registered_on date
  timezone text [note: 'IANA name, checked by the application']
  email text [note: 'contact; not blank']
  phone text [note: 'contact; CHECK ^\+[0-9]{6,15}$']
  status text [not null, default: 'provisioning', note: 'provisioning | active | suspended | archived']
  activated_at timestamptz
  suspended_at timestamptz
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  Note: '''
  Confirmed 2026-10-04 (C136, C139, C141); migration platform/tenancy/migrations/00001_tenants.sql.
  CHECKs: legal form and time zone before leaving provisioning (and a primary type, see
  tenant_institution_types); status timestamps follow
  the status; the operator is never suspended or archived and has no parent.
  RLS enabled: a tenant reads its own row; the operator tenant reads all and alone creates
  and changes them (lookup.is_operator_tenant, owned by erp_lookup); no delete policy.
  '''
}

Table tenant_institution_types {
  tenant_id uuid [not null, ref: > tenants.id, note: 'ON DELETE RESTRICT']
  institution_type text [not null, ref: > institution_types.code, note: 'ON DELETE RESTRICT; indexed']
  is_primary boolean [not null, default: false, note: 'at most one true per tenant (unique partial index)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  indexes {
    (tenant_id, institution_type) [pk]
  }

  Note: '''
  Confirmed 2026-10-04 (C141); migration platform/tenancy/migrations/00002_tenant_institution_types.sql.
  Every institution type of a tenant, the primary one flagged. A tenant outside provisioning
  has exactly one primary: a constraint trigger on tenants and on this table, deferred to commit.
  RLS enabled: a tenant reads its own rows; the operator reads all and alone adds, changes,
  and removes them.
  '''
}

Table domains {
  id uuid [pk, default: `uuidv7()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'ON DELETE RESTRICT']
  host text [not null, note: 'normalised: lowercase, ASCII (punycode), no port, no trailing dot; unique while not revoked']
  kind text [not null, note: 'platform | custom']
  serves text [not null, default: 'workspace', note: 'workspace or an app-defined portal key (C132)']
  status text [not null, default: 'pending', note: 'pending | active | revoked']
  verification_token text [note: 'custom only (check); TXT record at _bool-verify.<host>']
  verified_at timestamptz [note: 'required for an active custom host']
  activated_at timestamptz [note: 'required when active']
  revoked_at timestamptz [note: 'required when revoked']
  is_primary boolean [not null, default: false, note: 'active only; at most one per (tenant_id, serves)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  indexes {
    host [unique, note: 'partial: WHERE status <> revoked']
    (tenant_id, serves) [unique, note: 'partial: WHERE is_primary']
    tenant_id
  }

  Note: '''
  Confirmed 2026-10-05 (C158); migration platform/tenancy/migrations/00003_domains.sql.
  Every host that opens a tenant's workspace or one of its portals. Every active host serves
  directly (no redirect); the primary is the address emails, jobs, and links use. host, kind,
  and tenant_id never change (trigger). RLS enabled: a tenant reads its own domains; the
  operator reads all and alone adds and changes them; none are deleted (revoked instead).
  lookup.tenant_by_host (erp_lookup, C131) finds an active host's tenant before any tenant is known.
  '''
}

Table memberships {
  id uuid [pk, default: `uuidv7()`]
  tenant_id uuid [not null, ref: > tenants.id, note: 'ON DELETE RESTRICT']
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE RESTRICT (C134)']
  status text [not null, default: 'invited', note: 'invited | active | disabled | ended']
  is_owner boolean [not null, default: false, note: 'invited or active only; one per tenant']
  invited_by uuid [ref: > users.id, note: 'null when provisioning or a seed created it']
  invite_expires_at timestamptz [note: 'required when invited; past = expired']
  joined_at timestamptz [note: 'required when active or disabled']
  disabled_at timestamptz [note: 'required when disabled']
  ended_at timestamptz [note: 'required when ended']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'set by trigger on every update']

  indexes {
    (tenant_id, id) [unique, note: 'for tenant-aware foreign keys']
    (tenant_id, user_id) [unique, note: 'partial: WHERE status <> ended']
    tenant_id [unique, note: 'partial: WHERE is_owner']
    user_id
  }

  Note: '''
  Confirmed 2026-10-05 (C160); migration platform/tenancy/migrations/00004_memberships.sql.
  A person's access to a tenant; not employment. Seats are invited and active rows. Tenant and
  user never change; an ended membership is frozen (rejoining is a new row). RLS enabled: members
  read and change their tenant's memberships; the operator also reads, creates, and changes
  owner memberships of any tenant; none are deleted. lookup.active_membership (RequireMember)
  and lookup.memberships_of (the switcher) are owned by erp_lookup (C131).
  '''
}

TableGroup identity {
  users
}

TableGroup tenancy {
  tenants
  tenant_institution_types
  domains
  memberships
}

TableGroup reference {
  countries
  legal_forms
  sectors
  institution_types
}
