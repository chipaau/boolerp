{
  "$id": "https://bool.mv/schemas/identity/registration/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account (registration)",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "title": "Email",
          "type": "string",
          "format": "email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          },
          "description": "The address the account registered with (C85). Registration accepts only this one email; account.schema.json adds additional_emails. Keep the two schemas in step."
        },
        "phone": {
          "title": "Phone number",
          "description": "Required and verified by SMS, never used to log in (C85).",
          "type": "string",
          "format": "tel",
          "maxLength": 20,
          "ory.sh/kratos": {
            "verification": {
              "via": "sms"
            }
          }
        },
        "name": {
          "title": "Display name",
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "email",
        "phone"
      ],
      "additionalProperties": false
    }
  }
}
