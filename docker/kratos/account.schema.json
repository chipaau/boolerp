{
  "$id": "https://bool.mv/schemas/identity/account/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "emails": {
          "title": "Email addresses",
          "description": "The registration email plus addresses added through the admin API, already verified (C85). Keep in step with registration.schema.json, which differs only in allowing one email.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "ory.sh/kratos": {
              "credentials": {
                "password": {
                  "identifier": true
                }
              },
              "verification": {
                "via": "email"
              },
              "recovery": {
                "via": "email"
              }
            }
          }
        },
        "phone": {
          "title": "Phone number",
          "description": "Required and verified by SMS, never used to log in (C85).",
          "type": "string",
          "format": "tel",
          "maxLength": 20,
          "ory.sh/kratos": {
            "verification": {
              "via": "sms"
            }
          }
        },
        "name": {
          "title": "Display name",
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "emails",
        "phone"
      ],
      "additionalProperties": false
    }
  }
}
