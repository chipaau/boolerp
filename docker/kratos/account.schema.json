{
  "$id": "https://bool.mv/schemas/identity/account/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "title": "Email",
          "type": "string",
          "format": "email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          },
          "description": "The address the account registered with (C85). Same as registration.schema.json plus additional_emails; keep the two in step."
        },
        "phone": {
          "title": "Phone number",
          "description": "Required and verified by SMS, never used to log in (C85).",
          "type": "string",
          "format": "tel",
          "maxLength": 20,
          "ory.sh/kratos": {
            "verification": {
              "via": "sms"
            }
          }
        },
        "name": {
          "title": "Display name",
          "type": "string",
          "maxLength": 100
        },
        "additional_emails": {
          "title": "Additional emails",
          "description": "Further addresses, added only through the admin API and already verified (C85).",
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "title": "Email",
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "ory.sh/kratos": {
              "credentials": {
                "password": {
                  "identifier": true
                }
              },
              "verification": {
                "via": "email"
              },
              "recovery": {
                "via": "email"
              }
            }
          }
        }
      },
      "required": [
        "email",
        "phone"
      ],
      "additionalProperties": false
    }
  }
}
