-- Per-database setup for the runtime and migration roles (created by 10-roles.sh).
-- Run with psql in the target database; role names come from the container's
-- environment. Used for POSTGRES_DB by 10-roles.sh, and for extra databases
-- such as the feature tests' platform database (C79). The .psql extension keeps
-- the image's entrypoint from running it on its own.
\set ON_ERROR_STOP 1
\getenv app_role POSTGRES_APP_USER
\getenv migration_role POSTGRES_MIGRATE_USER

-- PostgreSQL 15+ already denies CREATE on public to PUBLIC; stating it keeps the
-- runtime role unable to create objects on any server version.
REVOKE CREATE ON SCHEMA public FROM PUBLIC;

-- New databases let PUBLIC connect; only the roles granted below (and the owner)
-- may, so other roles on the server, such as Kratos's (C85), cannot.
SELECT format('REVOKE CONNECT ON DATABASE %I FROM PUBLIC', current_database())
\gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'app_role')
\gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'app_role')
\gexec

SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'migration_role')
\gexec
SELECT format('GRANT USAGE, CREATE ON SCHEMA public TO %I', :'migration_role')
\gexec
SELECT format('CREATE SCHEMA %I AUTHORIZATION %I', 'migrations', :'migration_role')
WHERE NOT EXISTS (SELECT FROM pg_namespace WHERE nspname = 'migrations')
\gexec
REVOKE ALL ON SCHEMA migrations FROM PUBLIC;
SELECT format(
    'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO %I',
    :'migration_role', :'app_role'
)
\gexec
SELECT format(
    'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT USAGE ON SEQUENCES TO %I',
    :'migration_role', :'app_role'
)
\gexec

-- The lookup schema holds erp_lookup's functions (C131): it alone creates them;
-- the runtime and migration roles may only call them. Functions are not callable
-- by PUBLIC, whatever a migration forgets.
SELECT 'CREATE SCHEMA lookup AUTHORIZATION erp_lookup'
WHERE NOT EXISTS (SELECT FROM pg_namespace WHERE nspname = 'lookup')
\gexec
REVOKE ALL ON SCHEMA lookup FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO erp_lookup;
SELECT format('GRANT USAGE ON SCHEMA lookup TO %I, %I', :'app_role', :'migration_role')
\gexec
ALTER DEFAULT PRIVILEGES FOR ROLE erp_lookup IN SCHEMA lookup REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
SELECT format(
    'ALTER DEFAULT PRIVILEGES FOR ROLE erp_lookup IN SCHEMA lookup GRANT EXECUTE ON FUNCTIONS TO %I, %I',
    :'app_role', :'migration_role'
)
\gexec

-- The audit schema holds erp_audit's functions and audit_log's partitions (C164). The
-- runtime role has no USAGE on it, so it can never reach a partition directly (which
-- would bypass audit_log's row-level security); it reads audit_log itself, in public,
-- through those policies. The migration role uses audit.enable and creates partitions.
SELECT 'CREATE SCHEMA audit AUTHORIZATION erp_audit'
WHERE NOT EXISTS (SELECT FROM pg_namespace WHERE nspname = 'audit')
\gexec
REVOKE ALL ON SCHEMA audit FROM PUBLIC;
SELECT format('GRANT USAGE ON SCHEMA audit TO %I', :'migration_role')
\gexec
GRANT USAGE, CREATE ON SCHEMA public TO erp_audit;
ALTER DEFAULT PRIVILEGES FOR ROLE erp_audit IN SCHEMA audit REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
SELECT format(
    'ALTER DEFAULT PRIVILEGES FOR ROLE erp_audit IN SCHEMA audit GRANT EXECUTE ON FUNCTIONS TO %I',
    :'migration_role'
)
\gexec
-- audit_log (in public) is read by both roles, through its row-level security.
SELECT format(
    'ALTER DEFAULT PRIVILEGES FOR ROLE erp_audit IN SCHEMA public GRANT SELECT ON TABLES TO %I, %I',
    :'app_role', :'migration_role'
)
\gexec
