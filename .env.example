# Local dev config, loaded by Docker Compose. Copy this to `.env` and adjust.
# `.env` is gitignored (never commit real secrets); this example is committed.

# API runtime (APP_ENV: dev/test/staging/prod; log format: json/text)
APP_ENV=dev
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s
APP_LOG_FORMAT=json
# Log level: debug/info/warn/error
APP_LOG_LEVEL=info

# Postgres (compose uses these to init the DB)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# API dependency URLs (dev — point at the compose service names)
# APP_DSN = non-owner app role (least-privilege runtime); MIGRATE_DSN = owner (runs migrations).
APP_DSN=postgres://erp_app:erp_app@postgres:5432/erp?sslmode=disable
MIGRATE_DSN=postgres://erp:erp@postgres:5432/erp?sslmode=disable
APP_REDIS_URL=redis://redis:6379
