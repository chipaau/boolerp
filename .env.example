# Local dev configuration — the ONLY place these values live.
#
#   cp .env.example .env
#
# Nothing else in the repo carries a config value: compose.yaml interpolates ${VAR} with no
# fallback, the Go config has no environment-specific defaults, and kratos.yml takes its DSN from
# the environment. A missing variable therefore fails loudly at startup instead of silently
# resolving to something plausible — which is what let a deployment that forgot APP_DSN come up
# against a dev database with a dev password and report nothing wrong.
#
# `.env` is gitignored so a real secret pasted here never reaches git. The values below are
# dev-only and deliberately weak; a deployment supplies its own by other means.

APP_ENV=dev
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# Postgres (compose uses these to initialise the database, and for its healthcheck)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# APP_DSN   = the non-owner app role the API runs as (least privilege at runtime)
# MIGRATE_DSN = the owner role, which runs migrations and owns the schema
# KRATOS_DSN  = Kratos's own database, on the same server
APP_DSN=postgres://erp_app:erp_app@postgres:5432/erp?sslmode=disable
MIGRATE_DSN=postgres://erp:erp@postgres:5432/erp?sslmode=disable
KRATOS_DSN=postgres://erp:erp@postgres:5432/kratos?sslmode=disable

APP_REDIS_URL=redis://redis:6379

# Auth: Kratos (identity/sessions) + Cerbos (authz PDP) — internal service names on the compose network
APP_KRATOS_PUBLIC_URL=http://kratos:4433
APP_KRATOS_ADMIN_URL=http://kratos:4434
APP_CERBOS_HTTP_URL=http://cerbos:3592

# Observability. Tracing is off unless an endpoint is set (self-host default is stdout logs only);
# the local stack runs Tempo, so dev points at it.
APP_OTLP_ENDPOINT=tempo:4318
APP_METRICS_ENABLED=true

# Grafana: open, no login, everyone an admin. DEV ONLY — a deployment must never inherit these.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=true
