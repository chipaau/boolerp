# Local dev config, loaded by Docker Compose. Copy this to `.env` and adjust.
# `.env` is gitignored (never commit real secrets); this example is committed.

# API runtime (APP_ENV: dev/test/staging/prod; log format: json/text)
APP_ENV=dev
APP_PORT=8080
# Must be at least APP_HTTP_WRITE_TIMEOUT (C30)
APP_SHUTDOWN_TIMEOUT=35s
APP_LOG_FORMAT=json
# Log level: debug/info/warn/error
APP_LOG_LEVEL=info

# HTTP request limits and network deadlines
APP_HTTP_MAX_BODY_BYTES=1048576
APP_HTTP_READ_HEADER_TIMEOUT=5s
APP_HTTP_READ_TIMEOUT=15s
APP_HTTP_WRITE_TIMEOUT=30s
APP_HTTP_IDLE_TIMEOUT=60s
# Each request's deadline; below APP_HTTP_WRITE_TIMEOUT (C114)
APP_HTTP_REQUEST_TIMEOUT=25s

# Passwords are files, never variables (C80): Compose mounts the committed
# development files in docker/secrets/dev under /run/secrets.

# PostgreSQL cluster owner (bootstrap only; never passed to the API container)
POSTGRES_USER=erp
POSTGRES_DB=erp

# Separate PostgreSQL roles created when a new local database volume initializes.
POSTGRES_APP_USER=erp_app
POSTGRES_MIGRATE_USER=erp_migrate

# The API connects as the restricted runtime role. Compose derives APP_DB_NAME and
# APP_DB_USER from POSTGRES_DB and POSTGRES_APP_USER, and gives it the password as
# the file APP_DB_PASSWORD_FILE=/run/secrets/db_app_password (C80).
APP_DB_HOST=postgres
APP_DB_PORT=5432
# disable locally (no certificate); the application default is verify-full.
APP_DB_SSLMODE=disable
# The migration role's MIGRATE_DB_* settings are read only by cmd/migrate, never
# by the API (C47); `docker compose run --rm migrate` sets them, with the password
# as a file. See docs/platform/postgres.md.
APP_DB_MAX_CONNS=20
APP_DB_PING_TIMEOUT=2s
# Redis cache (C53). Local Redis has no password or TLS; the application default
# is TLS on. APP_REDIS_TIMEOUT bounds each cache call so an outage fails fast.
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_TLS=false
APP_REDIS_TIMEOUT=500ms

# Traces and metrics use the standard OpenTelemetry variables (C55). Compose exports to the
# lgtm service (Grafana at http://grafana.bool.test) by default, traces and metrics
# alike (C82); set one to none to turn it off, or console to print it.
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
