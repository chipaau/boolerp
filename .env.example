# Local dev config, loaded by Docker Compose. Copy this to `.env` and adjust.
# `.env` is gitignored (never commit real secrets); this example is committed.

APP_ENV=dev
APP_PORT=8080

# Postgres (compose uses these to init the DB)
POSTGRES_USER=goerp
POSTGRES_PASSWORD=goerp
POSTGRES_DB=goerp

# API dependency URLs (dev — point at the compose service names)
# APP_DSN = non-owner app role (least-privilege runtime); MIGRATE_DSN = owner (runs migrations).
APP_DSN=postgres://goerp_app:goerp_app@postgres:5432/goerp?sslmode=disable
MIGRATE_DSN=postgres://goerp:goerp@postgres:5432/goerp?sslmode=disable
APP_REDIS_URL=redis://redis:6379

# Auth: Kratos (identity/sessions) + Cerbos (authz PDP) — internal service URLs
APP_KRATOS_PUBLIC_URL=http://kratos:4433
APP_KRATOS_ADMIN_URL=http://kratos:4434
APP_CERBOS_HTTP_URL=http://cerbos:3592
